{
  "manifest_version": 3,
  "name": "falsealaram",
  "version": "0.1.0",
  "description": "Highlights suspicious claims and shows sourced corrections. AI-assisted - verify results.",
  "minimum_chrome_version": "110",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.x.ai/*",
    "https://api.openalex.org/*",
    "https://scholar.google.com/*",
    "https://en.wikipedia.org/*",
    "https://html.duckduckgo.com/*",
    "http://localhost:8787/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }],
  "action": { "default_popup": "popup/popup.html", "default_title": "falsealaram" },
  "options_ui": { "page": "options/options.html", "open_in_tab": true }
}
