{
  "manifest_version": 3,
  "name": "FalseAlarm",
  "version": "2.0.1",
  "description": "Researches factual questions with real sources and highlights questionable claims. AI-assisted results - verify before sharing.",
  "minimum_chrome_version": "110",
  "permissions": ["activeTab", "storage", "scripting", "tabs", "sidePanel"],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.x.ai/*",
    "https://api.openalex.org/*",
    "https://scholar.google.com/*",
    "https://en.wikipedia.org/*",
    "https://html.duckduckgo.com/*",
    "https://api.semanticscholar.org/*",
    "https://duckduckgo.com/*",
    "http://localhost:8787/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }],
  "action": { "default_popup": "popup/popup.html", "default_title": "FalseAlarm" },
  "side_panel": { "default_path": "agent/index.html" },
  "options_ui": { "page": "options/options.html", "open_in_tab": true }
}
